# Copy to .env and fill in. NEVER commit .env.
# Local:  cp .env.example .env  (defaults below work with docker-compose.local.yml)
# EC2:    .env is generated by scripts/deploy.sh from SSM Parameter Store (/todo-app/*)

# ---- Backend (Spring Boot) ----
# Local: jdbc:mysql://mysql:3306/todo_db (compose) or jdbc:mysql://localhost:3306/todo_db (bare mvn)
# AWS:   jdbc:mysql://<rds-endpoint>:3306/todo_db
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/todo_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me_local_only
# Cohere API key used by /api/todos/summarize
COHERE_API_KEY=your_cohere_api_key_here
# Slack incoming webhook that receives todo summaries
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional: SERVER_PORT (default 8080), SPRING_JPA_SHOW_SQL (default false), JAVA_OPTS

# ---- Frontend (React, build-time) ----
# Docker image bakes in "/api" (same origin, proxied by nginx). For `npm start` use the backend URL.
REACT_APP_API_BASE_URL=http://localhost:8080/api

# ---- Compose / deployment ----
# Registry namespace and tag of the images to run (CI deploys the commit SHA)
IMAGE_REPO=local
IMAGE_TAG=latest
# Host port for the web app
APP_PORT=80

# ---- Monitoring ----
GRAFANA_ADMIN_PASSWORD=change_me
# Slack webhook for Alertmanager alerts (can be the same as SLACK_WEBHOOK_URL or an #ops channel)
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
