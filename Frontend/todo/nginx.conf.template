server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Re-resolve the backend every 10s: a redeployed backend container gets a new IP,
    # and nginx would otherwise keep proxying to the old one (502 after every deploy).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Only the REST API is exposed publicly; /actuator stays on the internal network
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        # Keep the browser's Host so Spring sees API calls as same-origin (no CORS needed)
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
